# Copy to .env.local for local development. Never commit real values.
# All variables are server-only; none are exposed to the browser.

# Per-store request timeout in milliseconds (default 8000, allowed 1000-20000).
STORE_TIMEOUT_MS=8000

# Overall search budget in milliseconds (default 15000, allowed 2000-25000).
SEARCH_BUDGET_MS=15000
